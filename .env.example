# Copy this file to ".env" and paste your own key in.
# The .env file is git-ignored and is NOT part of the submission,
# so no API key is ever stored inside the notebook or the repository.
#
# Get a free key at: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=paste_your_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=minimal
GEMINI_USE_LEGACY_CACHE=false
